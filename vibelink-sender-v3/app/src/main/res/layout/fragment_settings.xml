<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 환경설정"
            android:textColor="#8899BB"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Controller IP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="컨트롤러 IP"
                android:textColor="#8899BB"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etControllerIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="192.168.0.x"
                android:textColorHint="#445577"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:inputType="text"
                android:padding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTapOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="탭 표시 권한"
                android:textColor="#8899BB"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="다른 앱 위에 그리기"
                android:textColor="#CCDDFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Account section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="계정"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#253060"
                android:gravity="center"
                android:text="👤"
                android:textSize="18sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로필"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="oscar@gmail.com"
                    android:textColor="#8899BB"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#445577"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Security section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보안"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <!-- Privacy mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#253060"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="프라이버시 모드" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="민감한 정보 보안" android:textColor="#8899BB" android:textSize="12sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switchPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#4A90FF" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#253060" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

            <!-- Screen share mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#253060"
                    android:gravity="center"
                    android:text="📺"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="화면 공유 모드" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="화면 녹화 시 표시" android:textColor="#8899BB" android:textSize="12sp" />
                </LinearLayout>
                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#445577" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#253060" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

            <!-- Remote control mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#253060"
                    android:gravity="center"
                    android:text="🖥️"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="원격 제어 모드" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="다른 기기에서 제어 허용" android:textColor="#8899BB" android:textSize="12sp" />
                </LinearLayout>
                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#445577" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#253060" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

            <!-- Sensitive handling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#253060"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="민감 처함" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="중요 작업 시 진행 물어봄" android:textColor="#8899BB" android:textSize="12sp" />
                </LinearLayout>
                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#4A90FF" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#253060" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

            <!-- Permission management -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#253060"
                    android:gravity="center"
                    android:text="🔑"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="권한 관리" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="앱 권한 설정" android:textColor="#8899BB" android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#445577"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
