<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clodock"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for MediaProjection screen capture -->
        <service
            android:name=".service.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Tap overlay - shows black cursor when Controller sends tap coords -->
        <service
            android:name=".service.TapOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="tap_overlay" />
        </service>

        <!-- Clipboard receiver for paste fallback (IME-independent Korean input) -->
        <receiver
            android:name=".receiver.ClipboardReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ADB_SET_CLIPBOARD" />
            </intent-filter>
        </receiver>

        <!-- Built-in IME service replaces ADBKeyboard.apk -->
        <!-- adb shell am broadcast -a ADB_INPUT_TEXT -es msg 'text' -->
        <service
            android:name=".ime.AdbInputMethodService"
            android:exported="true"
            android:label="Clodock Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/adb_keyboard_method" />
        </service>

    </application>

</manifest>
